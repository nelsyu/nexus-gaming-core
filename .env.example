DB_DSN=postgres://postgres:postgres@nexus_db:5432/nexus_db?sslmode=disable
PORT=8080
REDIS_SENTINEL_ADDRS=nexus_redis_sentinel:26379
REDIS_MASTER_NAME=mymaster
RABBITMQ_URL=amqp://guest:guest@nexus_rabbitmq:5672/
JWT_SECRET=super-secret-nexus-key-change-in-production
JWT_ACCESS_EXP_MINUTES=5
JWT_REFRESH_EXP_HOURS=168

# 可信任的反向代理 / 負載平衡器 (逗號分隔 IP 或 CIDR)。
# 只有來自這些位址的請求才會採信 X-Forwarded-For，用於遊戲商 IP 白名單判斷。
# 留空 = 不信任任何代理 (直接對外時請保持留空，否則任何人都能偽造來源 IP)
TRUSTED_PROXIES=
